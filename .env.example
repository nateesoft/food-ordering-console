# Shared JWT secret with food-ordering-service (must match CONSOLE_JWT_SECRET in service)
JWT_SECRET=food-ordering-super-secret-jwt-key-2025

# basePath prefix (must match next.config.mjs basePath)
NEXT_PUBLIC_BASE_PATH=/food-ordering-console

# food-ordering-service URL
SERVICE_URL=http://localhost:5555

# Base URL for reset password link (used in email)
NEXT_PUBLIC_BASE_URL=http://localhost:3001/food-ordering-console

# Next.js API base URL (used by lib/api.ts and BranchContext — must include basePath prefix)
NEXT_PUBLIC_API_URL=http://localhost:3001/food-ordering-console/api

# Customer-facing food-ordering-system URL (used for QR code generation)
NEXT_PUBLIC_FOOD_ORDERING_SYSTEM_URL=http://localhost:3333
